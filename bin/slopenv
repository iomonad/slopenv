#!/usr/bin/env bash

agent="opencode"
use_persistence=1
AVAILABLE_AGENTS="opencode claude-code"

usage() {
  echo "Usage: $(basename "$0") [-a agent] [-x] [-l] [directory]" >&2
  exit 1
}

while getopts "a:xlh" opt; do
  case "$opt" in
    a)
      agent="$OPTARG"
      ;;
    x)
      use_persistence=0
      ;;
    l)
      echo "$AVAILABLE_AGENTS"
      exit 0
      ;;
    h)
      usage
      ;;
    *)
      usage
      ;;
  esac
done
shift $((OPTIND - 1))

workdir="${1:-$(pwd)}"

# Resolve to absolute path
if [ ! -d "$workdir" ]; then
  echo "Error: directory '$workdir' does not exist" >&2
  exit 1
fi
workdir="$(cd "$workdir" && pwd)"

# Validate agent
valid_agent=0
for a in $AVAILABLE_AGENTS; do
  [ "$a" = "$agent" ] && valid_agent=1 && break
done
if [ "$valid_agent" -ne 1 ]; then
  echo "Error: unknown agent '$agent'" >&2
  echo "Available agents: $AVAILABLE_AGENTS" >&2
  exit 1
fi
if [ ! -d "$(dirname "$0")/../agents/$agent" ] && [ ! -d "./agents/$agent" ]; then
  echo "Error: agent image '$agent' not found locally" >&2
  echo "Available agents: $AVAILABLE_AGENTS" >&2
  exit 1
fi

image="ghcr.io/iomonad/slopenv/agent/${agent}:latest"

# Derive a readable, unique container name, e.g. slopenv-opencode-slopenv-12345
project="$(basename "$workdir" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_.-]/-/g')"
container_name="slopenv-${agent}-${project:-root}-$$"
target_dir="/workspace/$project"

persist_dir=""
if [ "$use_persistence" -eq 1 ]; then
  persist_base="${HOME}/.slopenv"
  mkdir -p "$persist_base/agents/${agent}"
  persist_dir="$persist_base/agents/${agent}"
fi

docker_args=(
  --rm -it
  --name "$container_name"
  -v "$workdir:$target_dir"
  -w /workspace
  --user "$(id -u):$(id -g)"
  -e HOME=/workspace
  -e TERM="${TERM:-xterm-256color}"
  -e LANG="${LANG:-C.UTF-8}"
)

if [ -n "$persist_dir" ]; then
  docker_args+=(-v "$persist_dir:/workspace/.agent-persist")
fi

if [ -n "$persist_dir" ]; then
  case "$agent" in
    claude-code)
      exec docker run "${docker_args[@]}" --entrypoint /bin/sh "$image" -c "mkdir -p /workspace/.agent-persist && ln -snf /workspace/.agent-persist /workspace/.claude && exec /sbin/tini -- claude $target_dir"
      ;;
    opencode)
      exec docker run "${docker_args[@]}" --entrypoint /bin/sh "$image" -c "mkdir -p /workspace/.agent-persist && mkdir -p /workspace/.config /workspace/.local/share /workspace/.local/state /workspace/.cache && ln -snf /workspace/.agent-persist /workspace/.config/opencode && ln -snf /workspace/.agent-persist /workspace/.local/share/opencode && ln -snf /workspace/.agent-persist /workspace/.local/state/opencode && ln -snf /workspace/.agent-persist /workspace/.opencode && exec /sbin/tini -- opencode -c $target_dir"
      ;;
    *)
      exec docker run "${docker_args[@]}" --entrypoint /bin/sh "$image" -c "mkdir -p /workspace/.agent-persist && mkdir -p /workspace/.config && ln -snf /workspace/.agent-persist /workspace/.$agent && ln -snf /workspace/.agent-persist /workspace/.config/$agent && exec /sbin/tini -- $agent $target_dir"
      ;;
  esac
else
  exec docker run "${docker_args[@]}" "$image" $target_dir
fi
