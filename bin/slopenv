#!/usr/bin/env bash

agent="opencode"
use_persistence=1

usage() {
  echo "Usage: $(basename "$0") [-a agent] [-x] [directory]" >&2
  exit 1
}

while getopts "a:xh" opt; do
  case "$opt" in
    a)
      agent="$OPTARG"
      ;;
    x)
      use_persistence=0
      ;;
    h)
      usage
      ;;
    *)
      usage
      ;;
  esac
done
shift $((OPTIND - 1))

workdir="${1:-$(pwd)}"

# Resolve to absolute path
if [ ! -d "$workdir" ]; then
  echo "Error: directory '$workdir' does not exist" >&2
  exit 1
fi
workdir="$(cd "$workdir" && pwd)"

image="ghcr.io/iomonad/slopenv/agent/${agent}:latest"

# Derive a readable, unique container name, e.g. slopenv-opencode-slopenv-12345
project="$(basename "$workdir" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_.-]/-/g')"
container_name="slopenv-${agent}-${project:-root}-$$"

persist_dir=""
if [ "$use_persistence" -eq 1 ]; then
  persist_base="${HOME}/.slopenv"
  mkdir -p "$persist_base/agents/${agent}"
  persist_dir="$persist_base/agents/${agent}"
fi

docker_args=(
  --rm -it
  --name "$container_name"
  -v "$workdir:/workspace/$workdir"
  -w /workspace
  --user "$(id -u):$(id -g)"
  -e HOME=/workspace
  -e TERM="${TERM:-xterm-256color}"
  -e LANG="${LANG:-C.UTF-8}"
)

if [ -n "$persist_dir" ]; then
  docker_args+=(-v "$persist_dir:/workspace/.agent-persist")
fi

if [ -n "$persist_dir" ]; then
  case "$agent" in
    claude-code)
      exec docker run "${docker_args[@]}" --entrypoint /bin/sh "$image" -c "mkdir -p /workspace/.agent-persist && ln -snf /workspace/.agent-persist /workspace/.claude && exec /sbin/tini -- claude /workspace/$workdir"
      ;;
    opencode)
      exec docker run "${docker_args[@]}" --entrypoint /bin/sh "$image" -c "mkdir -p /workspace/.agent-persist && mkdir -p /workspace/.config /workspace/.local/share /workspace/.local/state /workspace/.cache && ln -snf /workspace/.agent-persist /workspace/.config/opencode && ln -snf /workspace/.agent-persist /workspace/.local/share/opencode && ln -snf /workspace/.agent-persist /workspace/.local/state/opencode && ln -snf /workspace/.agent-persist /workspace/.opencode && exec /sbin/tini -- opencode -c /workspace/$workdir"
      ;;
    *)
      exec docker run "${docker_args[@]}" --entrypoint /bin/sh "$image" -c "mkdir -p /workspace/.agent-persist && mkdir -p /workspace/.config && ln -snf /workspace/.agent-persist /workspace/.$agent && ln -snf /workspace/.agent-persist /workspace/.config/$agent && exec /sbin/tini -- $agent /workspace/$workdir"
      ;;
  esac
else
  exec docker run "${docker_args[@]}" "$image" /workspace/$workdir
fi
